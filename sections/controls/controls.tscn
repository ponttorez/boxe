[gd_scene format=3]

[ext_resource type="Script" path="res://sections/controls/controls.gd" id="controls_gd"]
[ext_resource type="Script" path="res://common/responsive_row.gd" id="responsive_row_gd"]
[ext_resource type="Theme" path="res://themes/pixel_theme.tres" id="pixel_theme"]

[sub_resource type="ButtonGroup" id="ButtonGroup_normal"]

[sub_resource type="ButtonGroup" id="ButtonGroup_pixel"]

[node name="Controls" type="VBoxContainer"]
size_flags_horizontal = 3
script = ExtResource("controls_gd")
theme_override_constants/separation = 24

[node name="Header" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Overline" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"OverlineLabel"
text = "LIBRARY"

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Controls"

[node name="Subtitle" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "Every control in two themes, a regular one and a pixel art one. States blend, styles are layered, controls play sounds, and every text takes BBCode."
autowrap_mode = 3

[node name="Stages" type="Container" parent="."]
layout_mode = 2
script = ExtResource("responsive_row_gd")

[node name="Normal" type="PanelContainer" parent="Stages"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Stage"

[node name="Box" type="VBoxContainer" parent="Stages/Normal"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Badge" type="Label" parent="Stages/Normal/Box"]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"AccentBadgeLabel"
text = "Normal"

[node name="NormalControls" type="VBoxContainer" parent="Stages/Normal/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Buttons" type="HFlowContainer" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Save" type="Button" parent="Stages/Normal/Box/NormalControls/Buttons"]
layout_mode = 2
text = "[b]Save[/b]  [color=#a1a6ad]Ctrl+S[/color]"
bbcode_enabled = true

[node name="Play" type="Button" parent="Stages/Normal/Box/NormalControls/Buttons"]
layout_mode = 2
text = "[img=18]res://assets/icons/sound.svg[/img] Play [b]sound[/b]"
bbcode_enabled = true

[node name="Follow" type="Button" parent="Stages/Normal/Box/NormalControls/Buttons"]
layout_mode = 2
toggle_mode = true
text = "Follow"

[node name="Locked" type="Button" parent="Stages/Normal/Box/NormalControls/Buttons"]
layout_mode = 2
disabled = true
text = "Locked"

[node name="Link" type="LinkButton" parent="Stages/Normal/Box/NormalControls/Buttons"]
layout_mode = 2
size_flags_vertical = 4
text = "Read the [i]docs[/i]"
uri = "https://github.com/ponttorez/boxe"
bbcode_enabled = true

[node name="Toggles" type="HFlowContainer" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="CheckBox" type="CheckBox" parent="Stages/Normal/Box/NormalControls/Toggles"]
layout_mode = 2
text = "[b]Remember[/b] me"
bbcode_enabled = true

[node name="CheckButton" type="CheckButton" parent="Stages/Normal/Box/NormalControls/Toggles"]
layout_mode = 2
text = "Switch"

[node name="Day" type="CheckBox" parent="Stages/Normal/Box/NormalControls/Toggles"]
layout_mode = 2
button_pressed = true
button_group = SubResource("ButtonGroup_normal")
text = "Day"

[node name="Night" type="CheckBox" parent="Stages/Normal/Box/NormalControls/Toggles"]
layout_mode = 2
button_group = SubResource("ButtonGroup_normal")
text = "Night"

[node name="Pickers" type="HFlowContainer" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Option" type="OptionButton" parent="Stages/Normal/Box/NormalControls/Pickers"]
layout_mode = 2
selected = 0
item_count = 3
popup/item_0/text = "Small"
popup/item_0/id = 0
popup/item_1/text = "Medium"
popup/item_1/id = 1
popup/item_2/text = "Large"
popup/item_2/id = 2

[node name="Menu" type="MenuButton" parent="Stages/Normal/Box/NormalControls/Pickers"]
layout_mode = 2
text = "Open menu"
flat = false

[node name="Fields" type="HBoxContainer" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LineEdit" type="LineEdit" parent="Stages/Normal/Box/NormalControls/Fields"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Type, then press Enter"

[node name="SpinBox" type="SpinBox" parent="Stages/Normal/Box/NormalControls/Fields"]
layout_mode = 2
value = 3.0

[node name="TextEdit" type="TextEdit" parent="Stages/Normal/Box/NormalControls"]
custom_minimum_size = Vector2(0, 88)
layout_mode = 2
placeholder_text = "A few lines of text"
wrap_mode = 1

[node name="Slider" type="HSlider" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
max_value = 10.0
value = 4.0
tick_count = 11
ticks_on_borders = true

[node name="Progress" type="ProgressBar" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
value = 60.0

[node name="Tabs" type="TabBar" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
bbcode_enabled = true
current_tab = 0
tab_count = 3
tab_0/title = "[b]All[/b]"
tab_1/title = "Unread [color=#ff786b]3[/color]"
tab_2/title = "[i]Drafts[/i]"

[node name="List" type="ItemList" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
bbcode_enabled = true
auto_height = true
item_count = 3
item_0/text = "[b]Mira[/b]  [color=#a1a6ad]online[/color]"
item_1/text = "[b]Tom[/b]  [color=#a1a6ad]away[/color]"
item_2/text = "[b]Ada[/b]  [color=#5ed58b]in game[/color]"

[node name="Tree" type="Tree" parent="Stages/Normal/Box/NormalControls"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
bbcode_enabled = true
hide_root = true

[node name="Foldable" type="FoldableContainer" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
title = "[b]Details[/b]  [color=#a1a6ad](3)[/color]"
title_bbcode_enabled = true
folded = true

[node name="Text" type="Label" parent="Stages/Normal/Box/NormalControls/Foldable"]
layout_mode = 2
text = "Folded content."

[node name="Rich" type="Label" parent="Stages/Normal/Box/NormalControls"]
layout_mode = 2
text = "[b]Bold[/b], [i]italic[/i], [color=#fc7f7f]colored[/color], [code]code[/code], a [url=https://github.com/ponttorez/boxe]link[/url] and a [hint=Tooltips come from hint tags.]hint[/hint]."
bbcode_enabled = true
autowrap_mode = 3
mouse_filter = 0

[node name="Pixel" type="PanelContainer" parent="Stages"]
layout_mode = 2
size_flags_horizontal = 3
theme = ExtResource("pixel_theme")
theme_type_variation = &"Stage"

[node name="Box" type="VBoxContainer" parent="Stages/Pixel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Badge" type="Label" parent="Stages/Pixel/Box"]
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"AccentBadgeLabel"
text = "Pixel"

[node name="PixelControls" type="VBoxContainer" parent="Stages/Pixel/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Buttons" type="HFlowContainer" parent="Stages/Pixel/Box/PixelControls"]
layout_mode = 2
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10

[node name="Save" type="Button" parent="Stages/Pixel/Box/PixelControls/Buttons"]
layout_mode = 2
