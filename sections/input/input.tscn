[gd_scene format=3]

[ext_resource type="Script" path="res://sections/input/input.gd" id="input_gd"]
[ext_resource type="Script" path="res://common/responsive_grid.gd" id="responsive_grid_gd"]
[ext_resource type="Script" path="res://sections/input/hit_area_overlay.gd" id="hit_area_overlay_gd"]

[node name="Input" type="VBoxContainer"]
size_flags_horizontal = 3
script = ExtResource("input_gd")
theme_override_constants/separation = 24

[node name="Header" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Overline" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"OverlineLabel"
text = "CONTROL"

[node name="Title" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Input"

[node name="Subtitle" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"BodyLabel"
text = "Control.interactable = false blocks input for a control and its children but keeps their look, unlike disabled. raycast_padding moves each edge of the area that takes mouse and touch input, without changing the size or the drawing of the control."
autowrap_mode = 3

[node name="Cards" type="GridContainer" parent="."]
layout_mode = 2
script = ExtResource("responsive_grid_gd")
min_column_width = 380.0
max_columns = 1
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

[node name="Lock" type="PanelContainer" parent="Cards"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Card"

[node name="Box" type="VBoxContainer" parent="Cards/Lock"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="VBoxContainer" parent="Cards/Lock/Box"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Cards/Lock/Box/Header"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Lock a form"

[node name="Caption" type="Label" parent="Cards/Lock/Box/Header"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Lock the form with the switch, or press Save to lock it while it saves. interactable = false keeps the look of the form and consumes the presses, so it doesn't flash gray. Cancel stays outside of the locked part."
autowrap_mode = 3

[node name="Lock" type="CheckButton" parent="Cards/Lock/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Lock the form"

[node name="Stage" type="PanelContainer" parent="Cards/Lock/Box"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"Stage"

[node name="Content" type="VBoxContainer" parent="Cards/Lock/Box/Stage"]
layout_mode = 2
size_flags_vertical = 3
alignment = 1
theme_override_constants/separation = 12

[node name="Form" type="VBoxContainer" parent="Cards/Lock/Box/Stage/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Name" type="LineEdit" parent="Cards/Lock/Box/Stage/Content/Form"]
layout_mode = 2
text = "Ada Lovelace"

[node name="News" type="CheckBox" parent="Cards/Lock/Box/Stage/Content/Form"]
layout_mode = 2
text = "Subscribe"
button_pressed = true

[node name="Save" type="Button" parent="Cards/Lock/Box/Stage/Content/Form"]
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "Save"

[node name="Progress" type="ProgressBar" parent="Cards/Lock/Box/Stage/Content"]
unique_name_in_owner = true
layout_mode = 2
show_percentage = false

[node name="Cancel" type="Button" parent="Cards/Lock/Box/Stage/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Cancel"
disabled = true

[node name="Status" type="Label" parent="Cards/Lock/Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = ""
autowrap_mode = 3

[node name="HitAreas" type="PanelContainer" parent="Cards"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Card"

[node name="Box" type="VBoxContainer" parent="Cards/HitAreas"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Header" type="VBoxContainer" parent="Cards/HitAreas/Box"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Cards/HitAreas/Box/Header"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Larger and smaller areas"

[node name="Caption" type="Label" parent="Cards/HitAreas/Box/Header"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "A padding of -12 px on each side makes the 22 px close button easy to hit with a finger, and a padding of 14 px keeps the soft edges of the tile from reacting."
autowrap_mode = 3

[node name="Show" type="CheckButton" parent="Cards/HitAreas/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Show hit areas"
button_pressed = true

[node name="Stage" type="PanelContainer" parent="Cards/HitAreas/Box"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"Stage"

[node name="Content" type="VBoxContainer" parent="Cards/HitAreas/Box/Stage"]
layout_mode = 2
size_flags_vertical = 3
alignment = 1
theme_override_constants/separation = 12

[node name="Margin" type="MarginContainer" parent="Cards/HitAreas/Box/Stage/Content"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="Row" type="HBoxContainer" parent="Cards/HitAreas/Box/Stage/Content/Margin"]
layout_mode = 2
theme_override_constants/separation = 28
alignment = 1

[node name="Close" type="Button" parent="Cards/HitAreas/Box/Stage/Content/Margin/Row" groups=["hit_area"]]
custom_minimum_size = Vector2(22.0, 22.0)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"IconButton"
text = "×"
raycast_padding_left = -12.0
raycast_padding_top = -12.0
raycast_padding_right = -12.0
raycast_padding_bottom = -12.0

[node name="Tile" type="Button" parent="Cards/HitAreas/Box/Stage/Content/Margin/Row" groups=["hit_area"]]
custom_minimum_size = Vector2(150.0, 64.0)
layout_mode = 2
size_flags_vertical = 4
text = "Tile"
raycast_padding_left = 14.0
raycast_padding_top = 14.0
raycast_padding_right = 14.0
raycast_padding_bottom = 14.0

[node name="Overlay" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("hit_area_overlay_gd")
mouse_filter = 2
top_level = true
