[node name="Header" type="VBoxContainer" parent="Cards/SafeArea/Box"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Cards/SafeArea/Box/Header"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "Safe area"

[node name="Caption" type="Label" parent="Cards/SafeArea/Box/Header"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "MarginContainer.safe_area keeps the content out of display cutouts and system bars, or extends a background under them. The phones show a header laid out with each mode: tap one to use its mode in this demo. orientation_changed fires on 180° rotations too, and safe_area_changed when a cutout moves to another side: turn the phone around."
autowrap_mode = 3

