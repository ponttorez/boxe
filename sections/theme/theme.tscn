[node name="Text" type="TextEdit" parent="Cards/Prompt/Box" unique_id=1157528334]
unique_name_in_owner = true
auto_translate_mode = 2
custom_minimum_size = Vector2(0.0, 330.0)
layout_mode = 2
size_flags_vertical = 3
text = "Make a theme for this Godot project in res://themes/theme.tres that looks like the attached reference. The project uses boxe, a fork of Godot Engine:

- Style every control on the Library page (the Controls section): buttons, check boxes, switches, option and menu buttons, menu bars, popups, line and text edits, spin boxes, sliders, progress bars, tabs, item lists, trees, foldable containers, scroll bars, split containers, dialogs, tooltips and virtual joysticks.
- Give every state its own style box: normal, hover, pressed, hover_pressed, disabled and focus, and the checked, unchecked and radio states.
- Use StyleBoxLayered, with fill, outline and shadow layers for depth, rims and glows, and the same layers in every state of a control, so they blend layer by layer.
- Set transition_duration, transition_type and transition_ease on every style box, so the states blend.
- Draw the checks, switches, slider grabbers and tree checks with the checked, unchecked, grabber and grabber_highlight style boxes instead of icons, and give popups popup_separation and the popup_shadow and appear constants of Window.
- Match the colors, corner radii, depths, spacing and fonts of the reference, keep text readable on its backgrounds, keep the type variations already in the theme, and check every page of the demo."
editable = false
wrap_mode = 1

