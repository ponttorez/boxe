[gd_scene format=3]

[ext_resource type="Script" path="res://tools/motion/vignettes/plurals.gd" id="plurals_gd"]
[ext_resource type="FontVariation" path="res://fonts/ui_bold.tres" id="ui_bold_tres"]
[ext_resource type="FontVariation" path="res://fonts/ui_mono.tres" id="ui_mono_tres"]
[ext_resource type="Texture2D" path="res://tools/motion/icons/cross.svg" id="cross_svg"]
[ext_resource type="Texture2D" path="res://tools/motion/icons/check.svg" id="check_svg"]

[node name="Plurals" type="Control"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("plurals_gd")

[node name="Problem" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 30.0
offset_bottom = 78.0
grow_horizontal = 2
text = "A label can't pick plural forms"
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("ui_bold_tres")
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(1, 1, 1, 1)

[node name="Fix" type="Label" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_top = 82.0
offset_bottom = 108.0
grow_horizontal = 2
text = "Label.text_arguments + CSV translations"
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("ui_mono_tres")
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.4392, 0.7333, 1, 1)

[node name="Stages" type="HBoxContainer" parent="."]
layout_mode = 1
