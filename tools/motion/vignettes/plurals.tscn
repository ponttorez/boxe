anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 132.0
offset_right = -48.0
offset_bottom = -36.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24

[node name="Godot" type="PanelContainer" parent="Stages"]
