text = "New message"

[node name="Body" type="Label" parent="Stages/Godot/Box/Content/Card/Row/Text"]
layout_mode = 2
theme_type_variation = &"CaptionLabel"
text = "Mira: Are you coming tonight?"

[node name="Close" type="Button" parent="Stages/Godot/Box/Content/Card/Row"]
custom_minimum_size = Vector2(22.0, 22.0)
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"IconButton"
